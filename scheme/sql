cat > supabase/schema.sql << 'EOF'
-- ============================================
-- SCHEMA: hudvård e-handel
-- Kör i Supabase SQL editor (eller som migration)
-- ============================================

-- Produkter
create table products (
  id uuid primary key default gen_random_uuid(),
  namn text not null,
  beskrivning text,
  pris numeric(10,2) not null,
  steg text not null check (steg in ('rengoring','serum','fuktkram','solskydd')),
  hudtyper text[] not null default '{}',
  besvar text[] not null default '{}',
  kanslig_ok boolean not null default true,
  gravid_ok boolean not null default true,
  bild_url text,
  lager int not null default 0,
  skapad_at timestamptz not null default now()
);

-- Varukorg (en rad per användare+produkt)
create table cart_items (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null references auth.users(id) on delete cascade,
  product_id uuid not null references products(id) on delete cascade,
  antal int not null default 1 check (antal > 0),
  skapad_at timestamptz not null default now(),
  unique (user_id, product_id)
);

-- Ordrar
create table orders (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null references auth.users(id) on delete cascade,
  totalt_pris numeric(10,2) not null,
  status text not null default 'skapad' check (status in ('skapad','betald','skickad')),
  skapad_at timestamptz not null default now()
);

create table order_items (
  id uuid primary key default gen_random_uuid(),
  order_id uuid not null references orders(id) on delete cascade,
  product_id uuid not null references products(id),
  antal int not null,
  pris_vid_kop numeric(10,2) not null
);

-- Quiz-svar (valfritt att spara)
create table quiz_responses (
  id uuid primary key default gen_random_uuid(),
  user_id uuid references auth.users(id) on delete set null,
  hudtyp text not null,
  besvar text[] not null default '{}',
  kanslig boolean not null default false,
  gravid boolean not null default false,
  budget text,
  skapad_at timestamptz not null default now()
);

-- ============================================
-- ROW LEVEL SECURITY
-- ============================================

alter table products enable row level security;
create policy "Alla kan läsa produkter"
  on products for select using (true);

alter table cart_items enable row level security;
create policy "Användare ser och äger bara sin egen varukorg"
  on cart_items for all using (auth.uid() = user_id);

alter table orders enable row level security;
create policy "Användare ser bara sina egna ordrar"
  on orders for all using (auth.uid() = user_id);

alter table order_items enable row level security;
create policy "Användare ser bara rader kopplade till sina egna ordrar"
  on order_items for select using (
    exists (
      select 1 from orders
      where orders.id = order_items.order_id
      and orders.user_id = auth.uid()
    )
  );

alter table quiz_responses enable row level security;
create policy "Användare kan spara och läsa sina quiz-svar, anonymt tillåtet"
  on quiz_responses for all using (auth.uid() = user_id or user_id is null);
EOF

cat > lib/recommendation.ts << 'EOF'
import { supabase } from './supabaseClient';
// Byt ut raden ovan mot er egen klient om Lovable redan genererat en,
// t.ex. `import { supabase } from '@/integrations/supabase/client'`

export type QuizSvar = {
  hudtyp: 'torr' | 'fet' | 'kombinerad' | 'normal';
  besvar: string[];
  kanslig: boolean;
  gravid: boolean;
  budget?: 'låg' | 'mellan' | 'hög';
};

export type Product = {
  id: string;
  namn: string;
  beskrivning: string | null;
  pris: number;
  steg: 'rengoring' | 'serum' | 'fuktkram' | 'solskydd';
  hudtyper: string[];
  besvar: string[];
  kanslig_ok: boolean;
  gravid_ok: boolean;
  bild_url: string | null;
};

type Poangsatt = Product & { poang: number };

const STEG_ORDNING: Product['steg'][] = ['rengoring', 'serum', 'fuktkram', 'solskydd'];

export async function hamtaProdukter(): Promise<Product[]> {
  const { data, error } = await supabase.from('products').select('*');
  if (error) throw error;
  return data as Product[];
}

export function poangsattProdukter(produkter: Product[], svar: QuizSvar): Poangsatt[] {
  return produkter
    .filter(p => (!svar.gravid || p.gravid_ok) && (!svar.kanslig || p.kanslig_ok))
    .map(p => ({
      ...p,
      poang:
        (p.hudtyper.includes(svar.hudtyp) ? 3 : 0) +
        p.besvar.filter(b => svar.besvar.includes(b)).length * 2,
    }))
    .filter(p => p.poang > 0)
    .sort((a, b) => b.poang - a.poang);
}

export async function byggRutin(svar: QuizSvar): Promise<Product[]> {
  const produkter = await hamtaProdukter();
  const poangsatta = poangsattProdukter(produkter, svar);

  const rutin = STEG_ORDNING
    .map(steg => poangsatta.find(p => p.steg === steg))
    .filter((p): p is Poangsatt => Boolean(p));

  if (rutin.length === 0) {
    return produkter.filter(p => STEG_ORDNING.includes(p.steg)).slice(0, 4);
  }

  return rutin;
}

export async function sparaQuizSvar(svar: QuizSvar, userId?: string) {
  const { error } = await supabase.from('quiz_responses').insert({
    user_id: userId ?? null,
    hudtyp: svar.hudtyp,
    besvar: svar.besvar,
    kanslig: svar.kanslig,
    gravid: svar.gravid,
    budget: svar.budget,
  });
  if (error) throw error;
}
EOF

